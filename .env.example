# Kalshi API key (Kalshi -> Settings -> API). Without these the scanner runs in model-only mode.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi.pem
# prod | demo  (demo has no real sports combos; prod is read + RFQ only, never trades)
KALSHI_ENV=prod
# Kalshi taker fee coefficient: fee = ceil(FEE_RATE * contracts * P * (1-P))
FEE_RATE=0.07
